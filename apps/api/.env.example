# Copy to apps/api/.env for `pnpm --filter api dev`. main.ts loads .env when it exists.
# Every variable src/config.ts reads is listed here; config.spec.ts fails if one is missing.

# Required
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wehere
# HMAC key for /thumbs URLs, at least 32 characters. Rotating it invalidates every issued URL.
THUMB_SIGNING_SECRET=dev-only-thumb-secret-change-me-0123456789

PORT=4000

# Per-IP hourly limits (createRoom and joinRoom share the first value, as separate buckets)
ROOM_CREATE_LIMIT_PER_HOUR=10
INVITE_PREVIEW_LIMIT_PER_HOUR=60
PHOTO_LIMIT_PER_PARTICIPANT=2000

# Chat quotas: answers per room per hour, and for the whole service per KST day
CHAT_ROOM_HOURLY_LIMIT=30
CHAT_DAILY_LIMIT=500

# Place names: none (default, names nothing) | fake (made-up names for local runs) | naver
GEOCODER=fake
# Required when GEOCODER=naver (NCP Maps reverse geocoding)
NCP_CLIENT_ID=
NCP_CLIENT_SECRET=

# Chat model. Unset LLM_PROVIDER, or openai-compatible without LLM_MODEL/LLM_API_KEY,
# keeps the server up and answers chat with 503 server_misconfigured.
# fake | openai-compatible
LLM_PROVIDER=fake
# For openai-compatible, e.g. NVIDIA: LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=
LLM_API_KEY=
# Defaults to https://api.openai.com/v1
LLM_BASE_URL=
# Deadlines to the first event and between events
LLM_FIRST_TOKEN_TIMEOUT_MS=30000
LLM_IDLE_TIMEOUT_MS=15000
# Fake provider only: ok | length | mid_error | empty | rate_limited | error, and a delay before each event
LLM_FAKE_SCENARIO=ok
LLM_FAKE_DELAY_MS=0
